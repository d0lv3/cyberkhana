PORT=5001
MONGODB_URI=mongodb://localhost:27017/cyber-khana
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
NODE_ENV=development

# Which proxies in front of this server to trust for the real client IP (used by
# rate limiting and request logs). By default the app already trusts the local
# reverse proxy plus Cloudflare's own IP ranges, which matches the standard
# deployment (Cloudflare -> Coolify/Traefik -> app) with no configuration.
# Set this ONLY for a deployment that is not behind Cloudflare: a hop count
# (e.g. 1 for a single Nginx), or true/false. Never set it higher than the real
# hop count — the extra hops let a client forge its IP.
# TRUST_PROXY=1

# Extra browser origins allowed to call this API, comma-separated. Applies to
# both HTTP and Socket.IO — see allowedOrigins in src/index.ts.
#
# You usually do NOT need this. The platform calls /api on its own hostname and
# `npm run dev` proxies /api to this server, so the browser sees one origin and
# CORS never applies. Set it only for a frontend served from a genuinely
# different host than the API.
# FRONTEND_URL=https://staging.example.com

# Outbound mail (Resend). Optional — with no key the server logs the messages it
# would have sent and carries on. See src/services/mailer.ts.
RESEND_API_KEY=
# Must stay on the sending subdomain: support@cyberkhana.tech is an inbox on the
# apex (Cloudflare Email Routing) and sending as it fails the apex's SPF.
MAIL_FROM=CyberKhana <noreply@send.cyberkhana.tech>
MAIL_REPLY_TO=support@cyberkhana.tech
