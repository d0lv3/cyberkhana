# ── Which site is this build? ────────────────────────────────────────────────
# One repo, one build command, two deployments. The only difference is this.
#
#   app        app.cyberkhana.tech — the platform. Landing page, login,
#              dashboard, challenges, admin. This is the default: leave it
#              unset and you get today's behaviour.
#
#   marketing  cyberkhana.tech — the umbrella page for the project and nothing
#              else. Every platform link becomes an absolute link to
#              VITE_PLATFORM_ORIGIN, and old #/route links are forwarded there.
VITE_SITE=app

# Where the marketing build sends people for anything platform-shaped.
# Only read when VITE_SITE=marketing.
VITE_PLATFORM_ORIGIN=https://app.cyberkhana.tech

# The Academy, linked from the landing page on both builds.
VITE_ACADEMY_ORIGIN=https://academy.cyberkhana.tech

# ── API ──────────────────────────────────────────────────────────────────────
# Left blank the app calls /api on its own origin, which the reverse proxy
# forwards to the backend. Set it only if the API is on a different host.
VITE_API_URL=

VITE_ENABLE_SOCKET=true
